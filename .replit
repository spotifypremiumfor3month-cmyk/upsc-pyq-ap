modules = ["nodejs-20", "web", "python-3.12"]

[deployment]
deploymentTarget = "static"
publicDir = "artifacts/upsc-pyq/dist/public"

[deployment.build]
args = ["sh", "-c", "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/upsc-pyq run build"]

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19477
externalPort = 3000

